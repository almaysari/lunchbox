# وضع التشغيل: demo (منظمة وهمية كاملة عبر Mock Zoho) أو live
MODE=demo
PORT=3000
# العنوان العام للمنصة — يُستخدم في OAuth Redirect URI
BASE_URL=http://localhost:3000

# سر التشفير الإلزامي في live: يشفّر توكنات OAuth (AES-256-GCM) ويوقع الجلسات
# ولّده مثلاً بـ: openssl rand -hex 32
MADAR_SECRET=

# مستخدم الأدمن الأول (يُنشأ عند أول تشغيل فقط)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=demo1234

# مزامنة تلقائية لصناديق الـPilot (بالدقائق، 0 = تعطيل)
SYNC_INTERVAL_MINUTES=10

# حد الطلبات في الدقيقة نحو Zoho (الموثّق ~30 — نبقى تحته)
MADAR_MAX_RPM=25
