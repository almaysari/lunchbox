# ===== Madar configuration =====
# وضع التشغيل: live (الإنتاج/التطوير الحقيقي) أو demo (Mock Zoho — قاعدة demo منفصلة!)
MODE=live
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL — قاعدة التشغيل الوحيدة لكل الأوضاع
DATABASE_URL=postgresql://madar:CHANGE_ME@localhost:5432/madar
# لdocker compose:
POSTGRES_PASSWORD=CHANGE_ME

# ثلاثة أسرار مستقلة — إلزامية، 64 hex على الأقل لكل منها، ولا يجوز تساويها
# (التشفير at-rest / توقيع الجلسات / CSRF) — لتدوير مفتاح التشفير أضف MADAR_ENCRYPTION_KEY_V2
# ولّدهما: openssl rand -hex 32
MADAR_ENCRYPTION_KEY=
MADAR_SESSION_SECRET=
MADAR_CSRF_SECRET=

# مزامنة تلقائية لصناديق الـPilot المفعّلة يدويًا (بالدقائق، 0 = تعطيل)
SYNC_INTERVAL_MINUTES=10
# حد الطلبات/دقيقة نحو Zoho (الموثّق ~30)
MADAR_MAX_RPM=25
# حد حجم المرفق الواحد
MAX_ATTACHMENT_MB=25
# مسار تخزين المرفقات (خارج public دائمًا) — افتراضيًا data/attachments
# MADAR_ATTACH_DIR=
# منفذ تخزين المرفقات: local (افتراضي) — واجهة جاهزة لإضافة S3-compatible
# MADAR_STORAGE=local
