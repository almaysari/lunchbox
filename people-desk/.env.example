# وضع التشغيل: demo (بيانات وهمية) أو live (ربط حقيقي مع Zoho)
MODE=demo
PORT=3000

# بيانات تطبيق OAuth — أنشئه من https://api-console.zoho.com (نوع Server-based Applications)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/oauth/callback

# مركز البيانات الخاص بحسابك — غيّرهما معًا إذا كان حسابك على .eu أو .sa أو .in
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_MAIL_BASE=https://mail.zoho.com

# البريد المطلوب سحبه (اتركه فارغًا لاستخدام أول صندوق ظاهر للحساب المصرّح له)
# لصندوق HR المشترك: استخدم حساب التكامل الذي تُحوَّل إليه الرسائل — انظر README
ZOHO_MAILBOX=

# اسم المجلد المطلوب مسحه (فارغ = Inbox)
ZOHO_FOLDER=

# المزامنة التلقائية بالدقائق في الوضع live (0 = تعطيل)
SYNC_INTERVAL_MINUTES=10
